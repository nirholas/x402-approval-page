# ── Payment rails ───────────────────────────────────────────────────────────
# Both paid routes offer BOTH rails in their 402 challenge; the payer picks one.
# These are the suite's public receive addresses — change them to get paid.

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# EVM network: base-sepolia (testnet, default) or base (mainnet).
NETWORK=base-sepolia
# Solana network: mainnet-beta (default) or devnet.
SOLANA_NETWORK=mainnet-beta

# EVM facilitator. The x402.org default only settles base-sepolia — switch to a
# mainnet facilitator (e.g. https://facilitator.payai.network) with NETWORK=base.
FACILITATOR_URL=https://x402.org/facilitator
# Solana facilitator. PayAI's public lane needs no API key and sponsors the SOL fee.
SOLANA_FACILITATOR_URL=https://facilitator.payai.network
# Solana RPC used by the browser checkout endpoints the payment modal calls
# (POST /api/x402-checkout). The public RPC is heavily rate limited — use a
# dedicated one (Helius / Triton / QuickNode) for anything real.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# Facilitator sponsor account that pays the SOL network fee. Public, not a secret.
SOLANA_FEE_PAYER=2wKupLR9q6wXYppw8Gr2NvWxKBUqm4PPJKkQfoxHDBg4

# ── Approval policy ─────────────────────────────────────────────────────────
# Hard ceiling on what any single request may ask a human to authorize. This is
# the last line of defence against a compromised or confused agent — set it to
# the largest amount you would be comfortable seeing on an approval page.
MAX_APPROVAL_USD=100
# How long a request stays open when the agent doesn't specify. Max 86400.
DEFAULT_TTL_SECONDS=3600

# ── Signing ─────────────────────────────────────────────────────────────────
# HMAC-SHA256 key behind every grant and outcome signature. Unset falls back to
# an insecure dev default — set it before anyone relies on a grant as proof.
SIGNING_SECRET=

# ── Storage ─────────────────────────────────────────────────────────────────
# Requests live in memory by default: an approval that outlives a restart is
# usually one nobody should honour. Set a path to persist them instead.
# DATA_FILE=./data/requests.json

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4040
